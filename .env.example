# ---------------------------------------------------------------------------
# InvoiceMatch AI OS - environment configuration
# Copy this file to `.env` and fill in your local values. Never commit `.env`
# or put real API keys in ANY committed file (including this one).
# ---------------------------------------------------------------------------

# ---------- AI extraction (Groq) ----------
# Your Groq API key (backend only, never exposed to the frontend or logs).
# Set it in your local `.env`, and in the Vercel project settings for
# deployments. Leave empty to run offline with EXTRACTOR_MODE=deterministic_eval.
GROQ_API_KEY=

# Model used for structured extraction. Central configuration - do not
# hardcode model names anywhere else in the codebase.
# Note: `llama-3.3-70b-versatile` is now Enterprise-only on Groq; free /
# developer keys typically use `openai/gpt-oss-120b` or `openai/gpt-oss-20b`.
GROQ_MODEL=openai/gpt-oss-120b

# Extractor used by the analysis pipeline.
#   groq              -> real Groq API (production default)
#   deterministic_eval-> local evaluation-only extractor (tests/offline eval)
EXTRACTOR_MODE=groq

# ---------- Matching tolerances ----------
# Maximum acceptable absolute difference in monetary values.
AMOUNT_TOLERANCE=0.01
# Maximum acceptable absolute difference in quantities.
QUANTITY_TOLERANCE=0

# ---------- PDF upload ----------
# Maximum PDF upload size in MB.
PDF_MAX_SIZE_MB=10

# ---------- Storage ----------
# SQLite database file location (auto-created). Defaults to
# data/invoicematch.db locally. On Vercel (VERCEL=1) this is ignored unless
# explicitly set, and the database lives in the serverless function's
# /tmp dir - it is EPHEMERAL and may reset between requests. The deployed
# demo never claims durable persistence; /api/health reports it.
# DB_PATH=data/invoicematch.db

# ---------- Frankfurter exchange rates ----------
# Second external integration: ECB reference rates via the public
# Frankfurter API. No API key required. Only queried when a PO and its
# invoice use different currencies (same-currency documents never call it).
FRANKFURTER_BASE_URL=https://api.frankfurter.dev/v1
# Timeout (seconds) for each rate request.
FRANKFURTER_TIMEOUT_SECONDS=5